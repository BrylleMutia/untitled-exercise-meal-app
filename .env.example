# Client-safe Supabase configuration (publishable key only, never service-role).
# Add real values in .env.local; never commit project credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Use the exact origin where signup and password-reset flows are being tested.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only Edge Function secrets belong in Supabase secret management, NOT
# in this client environment file: USDA_FDC_API_KEY, DEEPSEEK_API_KEY.
# Configure this release label in Supabase Edge Function server configuration;
# it is intentionally not a NEXT_PUBLIC_* value.
# USDA_FDC_RELEASE=FoodData Central API verified 2026-09-22
# Optional server-side model override; the MVP default is deepseek-flash.
# DEEPSEEK_NUTRITION_MODEL=deepseek-flash
