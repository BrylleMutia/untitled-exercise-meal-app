# Client-safe Supabase configuration (publishable key only, never service-role).
# Add real values in .env.local; never commit project credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Use the exact origin where signup and password-reset flows are being tested.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
