{
  "name": "calisthenics-nutrition-coach",
  "version": "0.1.0",
  "private": true,
  "description": "Calisthenics and Nutrition Coach — responsive Next.js web app (demo-mode mockup)",
  "scripts": {
    "dev": "node scripts/copy-exercise-assets.mjs && next dev",
    "build": "node scripts/copy-exercise-assets.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:local": "vitest run",
    "supabase:start": "npx supabase@latest start",
    "supabase:reset": "npx supabase@latest db reset --local",
    "supabase:test": "npx supabase@latest test db --local",
    "supabase:test:rpc": "node scripts/test-supabase-rpc-smoke.mjs",
    "supabase:test:rpc:remote": "node scripts/test-supabase-rpc-remote.mjs",
    "supabase:test:concurrency": "node scripts/test-supabase-concurrency.mjs",
    "supabase:lint": "npx supabase@latest db lint --local",
    "supabase:types": "npx supabase@latest gen types --linked --lang=typescript --schema public > src/types/database.generated.ts",
    "supabase:push:dry": "npx supabase@latest db push --dry-run"
  },
  "dependencies": {
    "@bryllim/workout-guide": "^1.0.0",
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "lucide-react": "^1.41.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
