{
  "name": "cali-exercise-meal-planner",
  "version": "0.1.0",
  "private": true,
  "description": "Cali - Exercise and Meal Planner — authenticated responsive Next.js web app",
  "scripts": {
    "dev": "node scripts/copy-exercise-assets.mjs && next dev",
    "build": "node scripts/copy-exercise-assets.mjs && next build",
    "test:e2e": "playwright test",
    "test:e2e:release": "node scripts/run-local-supabase-test.mjs browser",
    "test:e2e:public": "playwright test --project=public",
    "test:email:local": "node scripts/run-email-confirmation-test.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:local": "vitest run",
    "test:repository": "node scripts/run-local-supabase-test.mjs repository",
    "supabase:start": "supabase start",
    "supabase:reset": "supabase db reset --local",
    "supabase:migrations": "supabase migration list --local",
    "supabase:test": "supabase test db --local",
    "supabase:test:rpc": "node scripts/test-supabase-rpc-smoke.mjs",
    "supabase:test:rpc:remote": "node scripts/test-supabase-rpc-remote.mjs",
    "supabase:test:providers:remote": "node scripts/test-supabase-provider-remote.mjs",
    "supabase:test:concurrency": "node scripts/test-supabase-concurrency.mjs",
    "supabase:lint": "supabase db lint --local",
    "supabase:types": "supabase gen types --linked --lang=typescript --schema public > src/types/database.generated.ts",
    "supabase:push:dry": "supabase db push --dry-run"
  },
  "dependencies": {
    "@bryllim/workout-guide": "^1.0.0",
    "@floating-ui/react": "^0.27.20",
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.41.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "postcss": "^8.5.28",
    "supabase": "2.118.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
